        "# =============================================================================\n",
        "# TEST 14 — ARE T2/T5 WRITABLE SEPARATELY BUT READ THROUGH T10 CONSENSUS?\n",
        "# Pythia-6.9B, two-digit addition, standalone Colab script\n",
        "#\n",
        "# Hypothesis:\n",
        "#   Residue channels can be written independently, but downstream readout asks\n",
        "#   for agreement with T10. Weak single-period steering may therefore reflect\n",
        "#   conflict from A's untouched T10 rather than a weak T2 or T5 channel.\n",
        "#\n",
        "# Main 3 x 3 matrix at each layer:\n",
        "#   Q25 write:  t2_only | t5_only | t2t5\n",
        "#   T10 action: keep    | ablate  | write_B\n",
        "#\n",
        "# Five controls:\n",
        "#   noop, t10_ablate_only, t10_write_only, random_ablate, shuffled_phase\n",
        "#\n",
        "# Important basis choice:\n",
        "#   T2 and T5 use the same Test-9 construction (T5 is internally orthogonal to\n",
        "#   T2). T10_CONTROL_BASIS defaults to \"exclusive\": the fitted T10 plane is\n",
        "#   stripped of Q25 overlap before T10 ablation/writing. This prevents a T10\n",
        "#   operation from directly erasing the T2/T5 intervention. Set it to \"raw\"\n",
        "#   only as a robustness run; overlap and coordinate audits are always saved.\n",
        "#\n",
        "# Recommended first run:\n",
        "#   SMOKE_TEST = True\n",
        "#\n",
        "# Colab install:\n",
        "# !pip install -q transformers accelerate scikit-learn scipy pandas tqdm\n",
        "# =============================================================================\n",
        "\n",
        "import gc\n",
        "import json\n",
        "import math\n",
        "import os\n",
        "import random\n",
        "from dataclasses import dataclass\n",
        "from typing import Dict, List, Sequence\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "from scipy.stats import binomtest\n",
        "from sklearn.linear_model import Ridge\n",
        "from tqdm.auto import tqdm\n",
        "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# CONFIG\n",
        "# =============================================================================\n",
        "\n",
        "MODEL_NAME = \"EleutherAI/pythia-6.9b\"\n",
        "OUT_DIR = \"/content/pythia_test14_channel_consensus_t10_gate\"\n",
        "\n",
        "SEED = 42\n",
        "RIDGE_ALPHA = 1.0\n",
        "BATCH_SIZE = 12\n",
        "\n",
        "SMOKE_TEST = False\n",
        "FIT_N = 600 if SMOKE_TEST else 4000\n",
        "EVAL_N = 180 if SMOKE_TEST else 1500\n",
        "\n",
        "LAYERS = [20, 24, 26] if SMOKE_TEST else list(range(18, 27))\n",
        "\n",
        "# \"exclusive\" is the interpretable main test. \"raw\" reproduces a literal raw\n",
        "# Q10 deletion but can also delete the overlapping part of Q2/Q5.\n",
        "T10_CONTROL_BASIS = \"exclusive\"  # \"exclusive\" or \"raw\"\n",
        "\n",
        "A_MAX = 99\n",
        "B_MAX = 99\n",
        "\n",
        "STEERING_MODES = [\"t2_only\", \"t5_only\", \"t2t5\"]\n",
        "T10_ACTIONS = [\"keep\", \"ablate\", \"write\"]\n",
        "CONTROL_CONDITIONS = [\n",
        "    \"noop\",\n",
        "    \"t10_ablate_only\",\n",
        "    \"t10_write_only\",\n",
        "    \"random_ablate\",\n",
        "    \"shuffled_phase\",\n",
        "]\n",
        "MATRIX_CONDITIONS = [\n",
        "    f\"{steering}__t10_{action}\"\n",
        "    for steering in STEERING_MODES\n",
        "    for action in T10_ACTIONS\n",
        "]\n",
        "CONDITIONS = CONTROL_CONDITIONS + MATRIX_CONDITIONS\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# UTILITIES\n",
        "# =============================================================================\n",
        "\n",
        "def set_seed(seed: int) -> None:\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "\n",
        "\n",
        "def make_prompt(a: int, b: int) -> str:\n",
        "    return f\"Output ONLY a number. {a}+{b}=\"\n",
        "\n",
        "\n",
        "def answer_token_id(tokenizer, number: int):\n",
        "    ids = tokenizer(str(int(number)), add_special_tokens=False)[\"input_ids\"]\n",
        "    return int(ids[0]) if len(ids) == 1 else None\n",
        "\n",
        "\n",
        "def pred_token_to_int(tokenizer, token_id: int):\n",
        "    text = tokenizer.decode([int(token_id)]).strip()\n",
        "    try:\n",
        "        return int(text)\n",
        "    except Exception:\n",
        "        return None\n",
        "\n",
        "\n",
        "def get_last_nonpad_positions(attention_mask: torch.Tensor) -> torch.Tensor:\n",
        "    positions = torch.arange(\n",
        "        attention_mask.shape[1],\n",
        "        device=attention_mask.device,\n",
        "    )\n",
        "    return (attention_mask * positions.unsqueeze(0)).max(dim=1).values.long()\n",
        "\n",
        "\n",
        "def get_blocks(model):\n",
        "    if hasattr(model, \"gpt_neox\") and hasattr(model.gpt_neox, \"layers\"):\n",
        "        return model.gpt_neox.layers\n",
        "    if hasattr(model, \"transformer\") and hasattr(model.transformer, \"h\"):\n",
        "        return model.transformer.h\n",
        "    if hasattr(model, \"model\") and hasattr(model.model, \"layers\"):\n",
        "        return model.model.layers\n",
        "    raise RuntimeError(\"Could not find transformer blocks.\")\n",
        "\n",
        "\n",
        "def orthonormalize_columns(matrix: np.ndarray, eps: float = 1e-8) -> np.ndarray:\n",
        "    U, singular_values, _ = np.linalg.svd(matrix, full_matrices=False)\n",
        "    threshold = eps * max(float(singular_values[0]), eps)\n",
        "    rank = int(np.sum(singular_values > threshold))\n",
        "    if rank == 0:\n",
        "        raise RuntimeError(\"Matrix has zero numerical rank.\")\n",
        "    return U[:, :rank]\n",
        "\n",
        "\n",
        "def safe_unit(coordinates: torch.Tensor, eps: float = 1e-8) -> torch.Tensor:\n",
        "    return coordinates / coordinates.norm(dim=1, keepdim=True).clamp_min(eps)\n",
        "\n",
        "\n",
        "def crt_mod2_mod5_to_mod10(residue2: int, residue5: int) -> int:\n",
        "    for digit in range(10):\n",
        "        if digit % 2 == int(residue2) and digit % 5 == int(residue5):\n",
        "            return digit\n",
        "    raise RuntimeError(\"CRT lookup failed.\")\n",
        "\n",
        "\n",
        "def condition_parts(condition: str):\n",
        "    if \"__t10_\" not in condition:\n",
        "        return None, None\n",
        "    steering, action = condition.split(\"__t10_\", maxsplit=1)\n",
        "    return steering, action\n",
        "\n",
        "\n",
        "def mean_ci95(values: np.ndarray):\n",
        "    values = np.asarray(values, dtype=np.float64)\n",
        "    if len(values) == 0:\n",
        "        return float(\"nan\"), float(\"nan\"), float(\"nan\")\n",
        "    mean = float(values.mean())\n",
        "    if len(values) == 1:\n",
        "        return mean, float(\"nan\"), float(\"nan\")\n",
        "    se = float(values.std(ddof=1) / math.sqrt(len(values)))\n",
        "    return mean, mean - 1.96 * se, mean + 1.96 * se\n",
        "\n",
        "\n",
        "def exact_mcnemar_p(a_values: np.ndarray, b_values: np.ndarray) -> float:\n",
        "    a_values = np.asarray(a_values, dtype=int)\n",
        "    b_values = np.asarray(b_values, dtype=int)\n",
        "    b = int(np.sum((a_values == 1) & (b_values == 0)))\n",
        "    c = int(np.sum((a_values == 0) & (b_values == 1)))\n",
        "    discordant = b + c\n",
        "    if discordant == 0:\n",
        "        return 1.0\n",
        "    return float(binomtest(min(b, c), discordant, 0.5).pvalue)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# MODEL\n",
        "# =============================================================================\n",
        "\n",
        "set_seed(SEED)\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "\n",
        "print(\"Loading tokenizer...\")\n",
        "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=True)\n",
        "if tokenizer.pad_token is None:\n",
        "    tokenizer.pad_token = tokenizer.eos_token\n",
        "tokenizer.padding_side = \"left\"\n",
        "\n",
        "print(\"Loading model...\")\n",
        "model = AutoModelForCausalLM.from_pretrained(\n",
        "    MODEL_NAME,\n",
        "    torch_dtype=torch.float16,\n",
        "    device_map=\"auto\",\n",
        "    low_cpu_mem_usage=True,\n",
        ").eval()\n",
        "model.config.pad_token_id = tokenizer.pad_token_id\n",
        "\n",
        "blocks = get_blocks(model)\n",
        "LAYERS = [layer for layer in LAYERS if 0 <= layer < len(blocks)]\n",
        "if not LAYERS:\n",
        "    raise RuntimeError(\"No valid intervention layers.\")\n",
        "\n",
        "print(\"layers:\", LAYERS)\n",
        "print(\"conditions:\", CONDITIONS)\n",
        "print(\"T10 control basis:\", T10_CONTROL_BASIS)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# NUMERIC TOKEN LOOKUP FOR UNITS-DIGIT LOG PROBABILITY\n",
        "# =============================================================================\n",
        "\n",
        "numeric_token_ids = []\n",
        "numeric_token_values = []\n",
        "for token_id in range(len(tokenizer)):\n",
        "    decoded = tokenizer.decode([token_id]).strip()\n",
        "    if decoded.isdigit():\n",
        "        try:\n",
        "            value = int(decoded)\n",
        "        except Exception:\n",
        "            continue\n",
        "        numeric_token_ids.append(token_id)\n",
        "        numeric_token_values.append(value)\n",
        "\n",
        "NUMERIC_TOKEN_IDS = torch.tensor(numeric_token_ids, dtype=torch.long)\n",
        "NUMERIC_TOKEN_VALUES = torch.tensor(numeric_token_values, dtype=torch.long)\n",
        "print(\"one-token numeric vocabulary entries:\", len(NUMERIC_TOKEN_IDS))\n",
        "\n",
        "\n",
        "def all_units_logprobs(logits: torch.Tensor) -> torch.Tensor:\n",
        "    local_ids = NUMERIC_TOKEN_IDS.to(logits.device)\n",
        "    local_values = NUMERIC_TOKEN_VALUES.to(logits.device)\n",
        "    numeric_logits = logits[:, local_ids].float()\n",
        "    denominator = torch.logsumexp(logits.float(), dim=1)\n",
        "    columns = []\n",
        "    for digit in range(10):\n",
        "        mask = (local_values % 10) == digit\n",
        "        numerator = torch.logsumexp(numeric_logits[:, mask], dim=1)\n",
        "        columns.append(numerator - denominator)\n",
        "    return torch.stack(columns, dim=1)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# DATASET AND DISJOINT FIT/EVALUATION SPLIT\n",
        "# =============================================================================\n",
        "\n",
        "def make_examples() -> List[dict]:\n",
        "    rows = []\n",
        "    for a in range(A_MAX + 1):\n",
        "        for b in range(B_MAX + 1):\n",
        "            total = a + b\n",
        "            target_token_id = answer_token_id(tokenizer, total)\n",
        "            if target_token_id is None:\n",
        "                continue\n",
        "            rows.append({\n",
        "                \"a\": a,\n",
        "                \"b\": b,\n",
        "                \"sum\": total,\n",
        "                \"units\": total % 10,\n",
        "                \"tens\": (total // 10) % 10,\n",
        "                \"target_token_id\": target_token_id,\n",
        "                \"prompt\": make_prompt(a, b),\n",
        "            })\n",
        "    return rows\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def baseline_filter(rows: Sequence[dict]) -> List[dict]:\n",
        "    kept = []\n",
        "    for start in tqdm(range(0, len(rows), BATCH_SIZE), desc=\"baseline filter\"):\n",
        "        batch = rows[start:start + BATCH_SIZE]\n",
        "        encoded = tokenizer(\n",
        "            [row[\"prompt\"] for row in batch],\n",
        "            return_tensors=\"pt\",\n",
        "            padding=True,\n",
        "            add_special_tokens=False,\n",
        "        ).to(model.device)\n",
        "        positions = get_last_nonpad_positions(encoded[\"attention_mask\"])\n",
        "        indices = torch.arange(len(batch), device=model.device)\n",
        "        logits = model(**encoded, use_cache=False).logits[indices, positions]\n",
        "        predictions = logits.argmax(dim=-1).detach().cpu().tolist()\n",
        "        for row, prediction_id in zip(batch, predictions):\n",
        "            if int(prediction_id) == int(row[\"target_token_id\"]):\n",
        "                kept.append(row)\n",
        "    return kept\n",
        "\n",
        "\n",
        "all_examples = make_examples()\n",
        "print(\"candidate examples:\", len(all_examples))\n",
        "baseline_correct = baseline_filter(all_examples)\n",
        "print(\"baseline correct:\", len(baseline_correct), \"/\", len(all_examples))\n",
        "\n",
        "split_rng = np.random.default_rng(SEED)\n",
        "split_rng.shuffle(baseline_correct)\n",
        "fit_count = min(FIT_N, len(baseline_correct))\n",
        "fit_rows = baseline_correct[:fit_count]\n",
        "eval_pool = baseline_correct[fit_count:]\n",
        "\n",
        "if len(fit_rows) < 100 or len(eval_pool) < 100:\n",
        "    raise RuntimeError(\"Not enough disjoint baseline-correct examples.\")\n",
        "\n",
        "print(\"fit rows:\", len(fit_rows))\n",
        "print(\"evaluation pool:\", len(eval_pool))\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# COLLECT FIT RESIDUALS\n",
        "# =============================================================================\n",
        "\n",
        "@torch.no_grad()\n",
        "def collect_equal_residuals(rows: Sequence[dict], layers: Sequence[int]):\n",
        "    store = {layer: [] for layer in layers}\n",
        "    sums = []\n",
        "    captured: Dict[int, torch.Tensor] = {}\n",
        "\n",
        "    def make_hook(layer: int):\n",
        "        def hook(module, inputs, output):\n",
        "            hidden = output[0] if isinstance(output, tuple) else output\n",
        "            captured[layer] = hidden.detach()\n",
        "        return hook\n",
        "\n",
        "    handles = [\n",
        "        blocks[layer].register_forward_hook(make_hook(layer))\n",
        "        for layer in layers\n",
        "    ]\n",
        "    try:\n",
        "        for start in tqdm(\n",
        "            range(0, len(rows), BATCH_SIZE),\n",
        "            desc='collect \"=\" residuals',\n",
        "        ):\n",
        "            batch = rows[start:start + BATCH_SIZE]\n",
        "            encoded = tokenizer(\n",
        "                [row[\"prompt\"] for row in batch],\n",
        "                return_tensors=\"pt\",\n",
        "                padding=True,\n",
        "                add_special_tokens=False,\n",
        "            ).to(model.device)\n",
        "            positions = get_last_nonpad_positions(encoded[\"attention_mask\"])\n",
        "            captured.clear()\n",
        "            model(**encoded, use_cache=False)\n",
        "            for layer in layers:\n",
        "                hidden = captured[layer]\n",
        "                local_positions = positions.to(hidden.device)\n",
        "                local_indices = torch.arange(len(batch), device=hidden.device)\n",
        "                vectors = hidden[local_indices, local_positions]\n",
        "                store[layer].append(vectors.float().cpu().numpy())\n",
        "            sums.extend(int(row[\"sum\"]) for row in batch)\n",
        "    finally:\n",
        "        for handle in handles:\n",
        "            handle.remove()\n",
        "\n",
        "    return (\n",
        "        {layer: np.concatenate(store[layer], axis=0) for layer in layers},\n",
        "        np.asarray(sums, dtype=np.float64),\n",
        "    )\n",
        "\n",
        "\n",
        "X_fit, fit_sums = collect_equal_residuals(fit_rows, LAYERS)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# FIT Q2, Q5, RAW/EXCLUSIVE Q10, AND RANDOM MATCHED-RANK PLANES\n",
        "# =============================================================================\n",
        "\n",
        "@dataclass\n",
        "class ChannelBases:\n",
        "    q2: torch.Tensor\n",
        "    q5: torch.Tensor\n",
        "    q25: torch.Tensor\n",
        "    q10_raw: torch.Tensor\n",
        "    q10_exclusive: torch.Tensor\n",
        "    q10_control: torch.Tensor\n",
        "    qrandom: torch.Tensor\n",
        "    q10_centroids: torch.Tensor\n",
        "    raw_overlap_cosine_1: float\n",
        "    raw_overlap_cosine_2: float\n",
        "    exclusive_overlap_cosine_max: float\n",
        "    exclusive_retained_frobenius: float\n",
        "\n",
        "\n",
        "def fit_channel_bases(\n",
        "    X: np.ndarray,\n",
        "    sums: np.ndarray,\n",
        "    layer: int,\n",
        ") -> ChannelBases:\n",
        "    y2 = np.cos(np.pi * sums).reshape(-1, 1)\n",
        "    theta5 = 2.0 * np.pi * sums / 5.0\n",
        "    y5 = np.column_stack([np.cos(theta5), np.sin(theta5)])\n",
        "    theta10 = 2.0 * np.pi * sums / 10.0\n",
        "    y10 = np.column_stack([np.cos(theta10), np.sin(theta10)])\n",
        "\n",
        "    w2 = Ridge(alpha=RIDGE_ALPHA, fit_intercept=True).fit(y2, X).coef_\n",
        "    w5 = Ridge(alpha=RIDGE_ALPHA, fit_intercept=True).fit(y5, X).coef_\n",
        "    w10 = Ridge(alpha=RIDGE_ALPHA, fit_intercept=True).fit(y10, X).coef_\n",
        "\n",
        "    q2 = orthonormalize_columns(w2)[:, :1]\n",
        "    w5_no_q2 = w5 - q2 @ (q2.T @ w5)\n",
        "    q5 = orthonormalize_columns(w5_no_q2)\n",
        "    if q5.shape[1] < 2:\n",
        "        raise RuntimeError(f\"Layer {layer}: T5 numerical rank < 2.\")\n",
        "    q5 = q5[:, :2]\n",
        "    q25, _ = np.linalg.qr(np.concatenate([q2, q5], axis=1))\n",
        "    q25 = q25[:, :3]\n",
        "\n",
        "    q10_raw = orthonormalize_columns(w10)\n",
        "    if q10_raw.shape[1] < 2:\n",
        "        raise RuntimeError(f\"Layer {layer}: raw T10 numerical rank < 2.\")\n",
        "    q10_raw = q10_raw[:, :2]\n",
        "\n",
        "    w10_exclusive = w10 - q25 @ (q25.T @ w10)\n",
        "    q10_exclusive = orthonormalize_columns(w10_exclusive)\n",
        "    if q10_exclusive.shape[1] < 2:\n",
        "        raise RuntimeError(f\"Layer {layer}: exclusive T10 rank < 2.\")\n",
        "    q10_exclusive = q10_exclusive[:, :2]\n",
        "\n",
        "    raw_overlap = np.linalg.svd(q25.T @ q10_raw, compute_uv=False)\n",
        "    exclusive_overlap = np.linalg.svd(\n",
        "        q25.T @ q10_exclusive,\n",
        "        compute_uv=False,\n",
        "    )\n",
        "    retained = float(\n",
        "        np.linalg.norm(w10_exclusive, ord=\"fro\")\n",
        "        / (np.linalg.norm(w10, ord=\"fro\") + 1e-12)\n",
        "    )\n",
        "\n",
        "    q10_control = (\n",
        "        q10_exclusive\n",
        "        if T10_CONTROL_BASIS == \"exclusive\"\n",
        "        else q10_raw\n",
        "    )\n",
        "\n",
        "    # Fixed random rank-2 plane, orthogonal to Q25 and controlled Q10.\n",
        "    rng = np.random.default_rng(SEED + 10000 + int(layer))\n",
        "    random_matrix = rng.standard_normal((X.shape[1], 2))\n",
        "    protected = np.concatenate([q25, q10_control], axis=1)\n",
        "    random_matrix = random_matrix - protected @ (protected.T @ random_matrix)\n",
        "    qrandom = orthonormalize_columns(random_matrix)\n",
        "    if qrandom.shape[1] < 2:\n",
        "        raise RuntimeError(f\"Layer {layer}: random control rank < 2.\")\n",
        "    qrandom = qrandom[:, :2]\n",
        "\n",
        "    q10_coordinates = X @ q10_control\n",
        "    centroids = []\n",
        "    for digit in range(10):\n",
        "        mask = (sums.astype(int) % 10) == digit\n",
        "        if not np.any(mask):\n",
        "            raise RuntimeError(f\"No fit examples for digit {digit}.\")\n",
        "        centroids.append(q10_coordinates[mask].mean(axis=0))\n",
        "    centroids = np.stack(centroids, axis=0)\n",
        "\n",
        "    return ChannelBases(\n",
        "        q2=torch.tensor(q2, dtype=torch.float32),\n",
        "        q5=torch.tensor(q5, dtype=torch.float32),\n",
        "        q25=torch.tensor(q25, dtype=torch.float32),\n",
        "        q10_raw=torch.tensor(q10_raw, dtype=torch.float32),\n",
        "        q10_exclusive=torch.tensor(q10_exclusive, dtype=torch.float32),\n",
        "        q10_control=torch.tensor(q10_control, dtype=torch.float32),\n",
        "        qrandom=torch.tensor(qrandom, dtype=torch.float32),\n",
        "        q10_centroids=torch.tensor(centroids, dtype=torch.float32),\n",
        "        raw_overlap_cosine_1=float(raw_overlap[0]),\n",
        "        raw_overlap_cosine_2=float(raw_overlap[1]),\n",
        "        exclusive_overlap_cosine_max=float(exclusive_overlap.max()),\n",
        "        exclusive_retained_frobenius=retained,\n",
        "    )\n",
        "\n",
        "\n",
        "if T10_CONTROL_BASIS not in {\"exclusive\", \"raw\"}:\n",
        "    raise ValueError(\"T10_CONTROL_BASIS must be 'exclusive' or 'raw'.\")\n",
        "\n",
        "bases_by_layer = {\n",
        "    layer: fit_channel_bases(X_fit[layer], fit_sums, layer)\n",
        "    for layer in LAYERS\n",
        "}\n",
        "\n",
        "basis_audit_df = pd.DataFrame([\n",
        "    {\n",
        "        \"layer\": layer,\n",
        "        \"t10_control_basis\": T10_CONTROL_BASIS,\n",
        "        \"raw_overlap_cosine_1\": bases.raw_overlap_cosine_1,\n",
        "        \"raw_overlap_cosine_2\": bases.raw_overlap_cosine_2,\n",
        "        \"exclusive_overlap_cosine_max\": bases.exclusive_overlap_cosine_max,\n",
        "        \"exclusive_retained_frobenius\": bases.exclusive_retained_frobenius,\n",
        "    }\n",
        "    for layer, bases in bases_by_layer.items()\n",
        "])\n",
        "basis_audit_path = os.path.join(OUT_DIR, \"test14_basis_overlap_audit.csv\")\n",
        "basis_audit_df.to_csv(basis_audit_path, index=False)\n",
        "\n",
        "del X_fit\n",
        "gc.collect()\n",
        "if torch.cuda.is_available():\n",
        "    torch.cuda.empty_cache()\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# BUILD IDENTIFIABLE, BALANCED A/B PAIRS\n",
        "# =============================================================================\n",
        "\n",
        "def build_pairs(pool: Sequence[dict], n: int, seed: int) -> List[dict]:\n",
        "    \"\"\"\n",
        "    Use B-A unit deltas {1,3,7,9}. Therefore B differs from A in both parity\n",
        "    and mod5, making t2_only, t5_only, and t2t5 targets all identifiable.\n",
        "    \"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "    pool = list(pool)\n",
        "    by_units = {\n",
        "        digit: [row for row in pool if row[\"units\"] == digit]\n",
        "        for digit in range(10)\n",
        "    }\n",
        "    n = min(n, len(pool))\n",
        "    a_indices = rng.permutation(len(pool))[:n]\n",
        "    deltas = np.resize(np.asarray([1, 3, 7, 9], dtype=int), n)\n",
        "    rng.shuffle(deltas)\n",
        "\n",
        "    pairs = []\n",
        "    for pair_id, (index, delta) in enumerate(zip(a_indices, deltas)):\n",
        "        A = pool[int(index)]\n",
        "        b_units = int((A[\"units\"] + int(delta)) % 10)\n",
        "        candidates = by_units[b_units]\n",
        "        if not candidates:\n",
        "            raise RuntimeError(f\"No B donors for units digit {b_units}.\")\n",
        "        B = candidates[int(rng.integers(len(candidates)))]\n",
        "\n",
        "        target_t2 = crt_mod2_mod5_to_mod10(B[\"sum\"] % 2, A[\"sum\"] % 5)\n",
        "        target_t5 = crt_mod2_mod5_to_mod10(A[\"sum\"] % 2, B[\"sum\"] % 5)\n",
        "        target_both = B[\"sum\"] % 10\n",
        "        targets = {A[\"units\"], target_t2, target_t5, target_both}\n",
        "        if len(targets) != 4:\n",
        "            raise RuntimeError(\"Pair construction produced non-distinct targets.\")\n",
        "\n",
        "        pairs.append({\n",
        "            \"pair_id\": pair_id,\n",
        "            \"A\": A,\n",
        "            \"B\": B,\n",
        "            \"delta_mod10\": int(delta),\n",
        "            \"target_t2_only\": int(target_t2),\n",
        "            \"target_t5_only\": int(target_t5),\n",
        "            \"target_t2t5\": int(target_both),\n",
        "        })\n",
        "    return pairs\n",
        "\n",
        "\n",
        "pairs = build_pairs(eval_pool, min(EVAL_N, len(eval_pool)), SEED + 1)\n",
        "print(\"evaluation pairs:\", len(pairs))\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# PRECOMPUTE CLEAN A/B COORDINATES AT EVERY TESTED LAYER\n",
        "# =============================================================================\n",
        "\n",
        "@dataclass\n",
        "class CleanCoordinates:\n",
        "    a2: torch.Tensor\n",
        "    b2: torch.Tensor\n",
        "    a5: torch.Tensor\n",
        "    b5: torch.Tensor\n",
        "    a10: torch.Tensor\n",
        "    b10: torch.Tensor\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def precompute_clean_coordinates(\n",
        "    pairs: Sequence[dict],\n",
        "    layers: Sequence[int],\n",
        ") -> Dict[int, CleanCoordinates]:\n",
        "    keys = [\"a2\", \"b2\", \"a5\", \"b5\", \"a10\", \"b10\"]\n",
        "    stores = {layer: {key: [] for key in keys} for layer in layers}\n",
        "    captured: Dict[int, torch.Tensor] = {}\n",
        "\n",
        "    def make_hook(layer: int):\n",
        "        def hook(module, inputs, output):\n",
        "            hidden = output[0] if isinstance(output, tuple) else output\n",
        "            captured[layer] = hidden.detach()\n",
        "        return hook\n",
        "\n",
        "    handles = [\n",
        "        blocks[layer].register_forward_hook(make_hook(layer))\n",
        "        for layer in layers\n",
        "    ]\n",
        "    try:\n",
        "        for start in tqdm(\n",
        "            range(0, len(pairs), BATCH_SIZE),\n",
        "            desc=\"precompute clean A/B coordinates\",\n",
        "        ):\n",
        "            batch = pairs[start:start + BATCH_SIZE]\n",
        "            batch_size = len(batch)\n",
        "            rows = [p[\"A\"] for p in batch] + [p[\"B\"] for p in batch]\n",
        "            encoded = tokenizer(\n",
        "                [row[\"prompt\"] for row in rows],\n",
        "                return_tensors=\"pt\",\n",
        "                padding=True,\n",
        "                add_special_tokens=False,\n",
        "            ).to(model.device)\n",
        "            positions = get_last_nonpad_positions(encoded[\"attention_mask\"])\n",
        "            captured.clear()\n",
        "            model(**encoded, use_cache=False)\n",
        "\n",
        "            for layer in layers:\n",
        "                hidden = captured[layer]\n",
        "                local_positions = positions.to(hidden.device)\n",
        "                local_indices = torch.arange(2 * batch_size, device=hidden.device)\n",
        "                vectors = hidden[local_indices, local_positions].float()\n",
        "                hA, hB = vectors[:batch_size], vectors[batch_size:]\n",
        "                bases = bases_by_layer[layer]\n",
        "                q2 = bases.q2.to(hidden.device)\n",
        "                q5 = bases.q5.to(hidden.device)\n",
        "                q10 = bases.q10_control.to(hidden.device)\n",
        "                stores[layer][\"a2\"].append((hA @ q2).cpu())\n",
        "                stores[layer][\"b2\"].append((hB @ q2).cpu())\n",
        "                stores[layer][\"a5\"].append((hA @ q5).cpu())\n",
        "                stores[layer][\"b5\"].append((hB @ q5).cpu())\n",
        "                stores[layer][\"a10\"].append((hA @ q10).cpu())\n",
        "                stores[layer][\"b10\"].append((hB @ q10).cpu())\n",
        "    finally:\n",
        "        for handle in handles:\n",
        "            handle.remove()\n",
        "\n",
        "    return {\n",
        "        layer: CleanCoordinates(**{\n",
        "            key: torch.cat(stores[layer][key], dim=0)\n",
        "            for key in keys\n",
        "        })\n",
        "        for layer in layers\n",
        "    }\n",
        "\n",
        "\n",
        "clean_coordinates_by_layer = precompute_clean_coordinates(pairs, LAYERS)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# HELD-OUT Q10 CALIBRATION\n",
        "# =============================================================================\n",
        "\n",
        "q10_calibration_rows = []\n",
        "for layer in LAYERS:\n",
        "    coordinates = clean_coordinates_by_layer[layer].a10\n",
        "    centroids = bases_by_layer[layer].q10_centroids\n",
        "    distances = torch.sum(\n",
        "        (coordinates[:, None, :] - centroids[None, :, :]) ** 2,\n",
        "        dim=2,\n",
        "    )\n",
        "    predicted = distances.argmin(dim=1).numpy()\n",
        "    truth = np.asarray([pair[\"A\"][\"units\"] for pair in pairs], dtype=int)\n",
        "    q10_calibration_rows.append({\n",
        "        \"layer\": layer,\n",
        "        \"n\": len(pairs),\n",
        "        \"t10_control_basis\": T10_CONTROL_BASIS,\n",
        "        \"q10_digit_accuracy\": float(np.mean(predicted == truth)),\n",
        "        \"chance\": 0.1,\n",
        "    })\n",
        "\n",
        "q10_calibration_df = pd.DataFrame(q10_calibration_rows)\n",
        "q10_calibration_path = os.path.join(OUT_DIR, \"test14_q10_calibration.csv\")\n",
        "q10_calibration_df.to_csv(q10_calibration_path, index=False)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# CONDITION TARGETS AND FLOAT32 INTERVENTION\n",
        "# =============================================================================\n",
        "\n",
        "def target_digit_for_condition(pair: dict, condition: str) -> int:\n",
        "    steering, _ = condition_parts(condition)\n",
        "    if steering == \"t2_only\":\n",
        "        return pair[\"target_t2_only\"]\n",
        "    if steering == \"t5_only\":\n",
        "        return pair[\"target_t5_only\"]\n",
        "    if steering == \"t2t5\" or condition == \"shuffled_phase\":\n",
        "        return pair[\"target_t2t5\"]\n",
        "    # T10 controls and noop are evaluated against B's full units digit.\n",
        "    return pair[\"target_t2t5\"]\n",
        "\n",
        "\n",
        "def make_target_coordinates(\n",
        "    clean: CleanCoordinates,\n",
        "    row_slice: slice,\n",
        "    condition: str,\n",
        "):\n",
        "    a2 = clean.a2[row_slice]\n",
        "    a5 = clean.a5[row_slice]\n",
        "    a10 = clean.a10[row_slice]\n",
        "    b2 = clean.b2[row_slice]\n",
        "    b5 = clean.b5[row_slice]\n",
        "    b10 = clean.b10[row_slice]\n",
        "\n",
        "    steering, t10_action = condition_parts(condition)\n",
        "    if condition == \"shuffled_phase\":\n",
        "        if len(a2) > 1:\n",
        "            donor2 = torch.roll(b2, shifts=1, dims=0)\n",
        "            donor5 = torch.roll(b5, shifts=1, dims=0)\n",
        "        else:\n",
        "            donor2 = -b2\n",
        "            donor5 = -b5\n",
        "        new2 = a2.abs() * torch.sign(donor2)\n",
        "        new5 = a5.norm(dim=1, keepdim=True) * safe_unit(donor5)\n",
        "        return new2, new5, None, \"keep\"\n",
        "\n",
        "    if steering == \"t2_only\":\n",
        "        new2 = a2.abs() * torch.sign(b2)\n",
        "        new5 = a5\n",
        "    elif steering == \"t5_only\":\n",
        "        new2 = a2\n",
        "        new5 = a5.norm(dim=1, keepdim=True) * safe_unit(b5)\n",
        "    elif steering == \"t2t5\":\n",
        "        new2 = a2.abs() * torch.sign(b2)\n",
        "        new5 = a5.norm(dim=1, keepdim=True) * safe_unit(b5)\n",
        "    else:\n",
        "        new2 = None\n",
        "        new5 = None\n",
        "\n",
        "    if condition == \"t10_ablate_only\":\n",
        "        t10_action = \"ablate\"\n",
        "    elif condition == \"t10_write_only\":\n",
        "        t10_action = \"write\"\n",
        "    elif condition == \"random_ablate\":\n",
        "        t10_action = \"random\"\n",
        "    elif condition == \"noop\":\n",
        "        t10_action = \"keep\"\n",
        "\n",
        "    new10 = None\n",
        "    if t10_action == \"write\":\n",
        "        new10 = a10.norm(dim=1, keepdim=True) * safe_unit(b10)\n",
        "    return new2, new5, new10, t10_action\n",
        "\n",
        "\n",
        "def make_intervention_hook(\n",
        "    bases: ChannelBases,\n",
        "    positions: torch.Tensor,\n",
        "    batch_indices: torch.Tensor,\n",
        "    new2: torch.Tensor,\n",
        "    new5: torch.Tensor,\n",
        "    new10: torch.Tensor,\n",
        "    t10_action: str,\n",
        "    audit_store: list,\n",
        "    condition: str,\n",
        "    layer: int,\n",
        "):\n",
        "    def hook(module, inputs, output):\n",
        "        if isinstance(output, tuple):\n",
        "            hidden = output[0].clone()\n",
        "            rest = tuple(output[1:])\n",
        "        else:\n",
        "            hidden = output.clone()\n",
        "            rest = None\n",
        "\n",
        "        local_positions = positions.to(hidden.device)\n",
        "        local_indices = batch_indices.to(hidden.device)\n",
        "        original = hidden[local_indices, local_positions]\n",
        "        edited = original.float()\n",
        "\n",
        "        q2 = bases.q2.to(edited.device)\n",
        "        q5 = bases.q5.to(edited.device)\n",
        "        q25 = bases.q25.to(edited.device)\n",
        "        q10 = bases.q10_control.to(edited.device)\n",
        "        qrandom = bases.qrandom.to(edited.device)\n",
        "\n",
        "        before_q25 = edited @ q25\n",
        "        before_q10 = edited @ q10\n",
        "\n",
        "        if new2 is not None and new5 is not None:\n",
        "            target25 = (\n",
        "                new2.to(edited.device) @ q2.T\n",
        "                + new5.to(edited.device) @ q5.T\n",
        "            )\n",
        "            edited = edited - (edited @ q25) @ q25.T + target25\n",
        "\n",
        "        if t10_action == \"ablate\":\n",
        "            edited = edited - (edited @ q10) @ q10.T\n",
        "        elif t10_action == \"write\":\n",
        "            target10 = new10.to(edited.device) @ q10.T\n",
        "            edited = edited - (edited @ q10) @ q10.T + target10\n",
        "        elif t10_action == \"random\":\n",
        "            q10_component = (edited @ q10) @ q10.T\n",
        "            random_component = (edited @ qrandom) @ qrandom.T\n",
        "            desired_norm = q10_component.norm(dim=1, keepdim=True)\n",
        "            random_direction = safe_unit(random_component)\n",
        "            edited = edited - desired_norm * random_direction\n",
        "        elif t10_action != \"keep\":\n",
        "            raise ValueError(t10_action)\n",
        "\n",
        "        after_q25 = edited @ q25\n",
        "        after_q10 = edited @ q10\n",
        "        q25_relative_change = (\n",
        "            (after_q25 - before_q25).norm(dim=1)\n",
        "            / before_q25.norm(dim=1).clamp_min(1e-8)\n",
        "        )\n",
        "        q10_relative_norm = (\n",
        "            after_q10.norm(dim=1)\n",
        "            / before_q10.norm(dim=1).clamp_min(1e-8)\n",
        "        )\n",
        "\n",
        "        audit_store.append({\n",
        "            \"layer\": layer,\n",
        "            \"condition\": condition,\n",
        "            \"n\": int(len(edited)),\n",
        "            \"mean_post_over_pre_q10_norm\": float(q10_relative_norm.mean().item()),\n",
        "            \"mean_relative_q25_coordinate_change\": float(\n",
        "                q25_relative_change.mean().item()\n",
        "            ),\n",
        "            \"mean_edit_norm\": float((edited - original.float()).norm(dim=1).mean().item()),\n",
        "        })\n",
        "\n",
        "        hidden[local_indices, local_positions] = edited.to(hidden.dtype)\n",
        "        return hidden if rest is None else (hidden,) + rest\n",
        "\n",
        "    return hook\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# EVALUATE ONE LAYER/CONDITION\n",
        "# =============================================================================\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate_layer_condition(\n",
        "    pairs: Sequence[dict],\n",
        "    layer: int,\n",
        "    condition: str,\n",
        "):\n",
        "    records = []\n",
        "    audit_batches = []\n",
        "    bases = bases_by_layer[layer]\n",
        "    clean = clean_coordinates_by_layer[layer]\n",
        "\n",
        "    for start in tqdm(\n",
        "        range(0, len(pairs), BATCH_SIZE),\n",
        "        desc=f\"L{layer} {condition}\",\n",
        "        leave=False,\n",
        "    ):\n",
        "        batch = pairs[start:start + BATCH_SIZE]\n",
        "        row_slice = slice(start, start + len(batch))\n",
        "        encoded = tokenizer(\n",
        "            [pair[\"A\"][\"prompt\"] for pair in batch],\n",
        "            return_tensors=\"pt\",\n",
        "            padding=True,\n",
        "            add_special_tokens=False,\n",
        "        ).to(model.device)\n",
        "        positions = get_last_nonpad_positions(encoded[\"attention_mask\"])\n",
        "        indices = torch.arange(len(batch), device=model.device)\n",
        "\n",
        "        new2, new5, new10, t10_action = make_target_coordinates(\n",
        "            clean,\n",
        "            row_slice,\n",
        "            condition,\n",
        "        )\n",
        "\n",
        "        # noop is the only true no-hook health control.\n",
        "        handle = None\n",
        "        if condition != \"noop\":\n",
        "            handle = blocks[layer].register_forward_hook(\n",
        "                make_intervention_hook(\n",
        "                    bases=bases,\n",
        "                    positions=positions,\n",
        "                    batch_indices=indices,\n",
        "                    new2=new2,\n",
        "                    new5=new5,\n",
        "                    new10=new10,\n",
        "                    t10_action=t10_action,\n",
        "                    audit_store=audit_batches,\n",
        "                    condition=condition,\n",
        "                    layer=layer,\n",
        "                )\n",
        "            )\n",
        "        try:\n",
        "            logits = model(**encoded, use_cache=False).logits[indices, positions].float()\n",
        "        finally:\n",
        "            if handle is not None:\n",
        "                handle.remove()\n",
        "\n",
        "        prediction_ids = logits.argmax(dim=-1).detach().cpu().tolist()\n",
        "        unit_logprobs = all_units_logprobs(logits).detach().cpu()\n",
        "\n",
        "        for local_index, (pair, prediction_id) in enumerate(\n",
        "            zip(batch, prediction_ids)\n",
        "        ):\n",
        "            A = pair[\"A\"]\n",
        "            target_digit = target_digit_for_condition(pair, condition)\n",
        "            prediction = pred_token_to_int(tokenizer, prediction_id)\n",
        "            parseable = int(prediction is not None)\n",
        "            follow2 = int(parseable and prediction % 2 == target_digit % 2)\n",
        "            follow5 = int(parseable and prediction % 5 == target_digit % 5)\n",
        "            follow10 = int(parseable and prediction % 10 == target_digit)\n",
        "            stay_A = int(parseable and prediction % 10 == A[\"units\"])\n",
        "            stay_tens = int(\n",
        "                parseable and (prediction // 10) % 10 == A[\"tens\"]\n",
        "            )\n",
        "            target_lp = float(unit_logprobs[local_index, target_digit].item())\n",
        "            A_lp = float(unit_logprobs[local_index, A[\"units\"]].item())\n",
        "\n",
        "            row = {\n",
        "                \"pair_id\": pair[\"pair_id\"],\n",
        "                \"layer\": layer,\n",
        "                \"condition\": condition,\n",
        "                \"t10_control_basis\": T10_CONTROL_BASIS,\n",
        "                \"a_A\": A[\"a\"],\n",
        "                \"b_A\": A[\"b\"],\n",
        "                \"sum_A\": A[\"sum\"],\n",
        "                \"units_A\": A[\"units\"],\n",
        "                \"tens_A\": A[\"tens\"],\n",
        "                \"sum_B\": pair[\"B\"][\"sum\"],\n",
        "                \"units_B\": pair[\"B\"][\"units\"],\n",
        "                \"delta_mod10\": pair[\"delta_mod10\"],\n",
        "                \"target_t2_only\": pair[\"target_t2_only\"],\n",
        "                \"target_t5_only\": pair[\"target_t5_only\"],\n",
        "                \"target_t2t5\": pair[\"target_t2t5\"],\n",
        "                \"analysis_target_mod10\": target_digit,\n",
        "                \"pred\": prediction,\n",
        "                \"parseable\": parseable,\n",
        "                \"exact_A\": int(int(prediction_id) == int(A[\"target_token_id\"])),\n",
        "                \"stay_A_mod10\": stay_A,\n",
        "                \"stay_A_tens\": stay_tens,\n",
        "                \"follow_target_mod2\": follow2,\n",
        "                \"follow_target_mod5\": follow5,\n",
        "                \"follow_target_mod10\": follow10,\n",
        "                \"target_units_logprob\": target_lp,\n",
        "                \"A_units_logprob\": A_lp,\n",
        "                \"target_vs_A_units_logprob\": target_lp - A_lp,\n",
        "            }\n",
        "            for digit in range(10):\n",
        "                row[f\"units_logprob_{digit}\"] = float(\n",
        "                    unit_logprobs[local_index, digit].item()\n",
        "                )\n",
        "            records.append(row)\n",
        "\n",
        "    frame = pd.DataFrame(records)\n",
        "    summary = {\n",
        "        \"layer\": layer,\n",
        "        \"condition\": condition,\n",
        "        \"n\": len(frame),\n",
        "        \"parseable\": frame[\"parseable\"].mean(),\n",
        "        \"exact_A\": frame[\"exact_A\"].mean(),\n",
        "        \"stay_A_mod10\": frame[\"stay_A_mod10\"].mean(),\n",
        "        \"stay_A_tens\": frame[\"stay_A_tens\"].mean(),\n",
        "        \"follow_target_mod2\": frame[\"follow_target_mod2\"].mean(),\n",
        "        \"follow_target_mod5\": frame[\"follow_target_mod5\"].mean(),\n",
        "        \"follow_target_mod10\": frame[\"follow_target_mod10\"].mean(),\n",
        "        \"mean_target_vs_A_units_logprob\": frame[\n",
        "            \"target_vs_A_units_logprob\"\n",
        "        ].mean(),\n",
        "    }\n",
        "    return summary, records, audit_batches\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# RUN ALL PAIRED CONDITIONS\n",
        "# =============================================================================\n",
        "\n",
        "all_summaries = []\n",
        "all_records = []\n",
        "all_audits = []\n",
        "\n",
        "for layer in LAYERS:\n",
        "    for condition in CONDITIONS:\n",
        "        summary, records, audits = evaluate_layer_condition(\n",
        "            pairs,\n",
        "            layer,\n",
        "            condition,\n",
        "        )\n",
        "        all_summaries.append(summary)\n",
        "        all_records.extend(records)\n",
        "        all_audits.extend(audits)\n",
        "        print(summary)\n",
        "\n",
        "        pd.DataFrame(all_summaries).to_csv(\n",
        "            os.path.join(OUT_DIR, \"test14_summary_partial.csv\"),\n",
        "            index=False,\n",
        "        )\n",
        "        # Per-cell checkpoints avoid repeatedly rewriting the entire growing\n",
        "        # prediction table during the long full sweep.\n",
        "        pd.DataFrame(records).to_csv(\n",
        "            os.path.join(\n",
        "                OUT_DIR,\n",
        "                f\"test14_checkpoint_L{layer}_{condition}.csv\",\n",
        "            ),\n",
        "            index=False,\n",
        "        )\n",
        "\n",
        "summary_df = pd.DataFrame(all_summaries)\n",
        "predictions_df = pd.DataFrame(all_records)\n",
        "audit_df = pd.DataFrame(all_audits)\n",
        "\n",
        "summary_path = os.path.join(OUT_DIR, \"test14_summary.csv\")\n",
        "predictions_path = os.path.join(OUT_DIR, \"test14_predictions.csv\")\n",
        "audit_path = os.path.join(OUT_DIR, \"test14_intervention_audit.csv\")\n",
        "summary_df.to_csv(summary_path, index=False)\n",
        "predictions_df.to_csv(predictions_path, index=False)\n",
        "audit_df.to_csv(audit_path, index=False)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# PAIRED COLUMN-CONTROL CONTRASTS\n",
        "# =============================================================================\n",
        "\n",
        "def column_baseline_condition(t10_action: str) -> str:\n",
        "    if t10_action == \"keep\":\n",
        "        return \"noop\"\n",
        "    if t10_action == \"ablate\":\n",
        "        return \"t10_ablate_only\"\n",
        "    if t10_action == \"write\":\n",
        "        return \"t10_write_only\"\n",
        "    raise ValueError(t10_action)\n",
        "\n",
        "\n",
        "paired_rows = []\n",
        "binary_metrics = [\n",
        "    \"follow_target_mod2\",\n",
        "    \"follow_target_mod5\",\n",
        "    \"follow_target_mod10\",\n",
        "    \"stay_A_mod10\",\n",
        "    \"stay_A_tens\",\n",
        "    \"exact_A\",\n",
        "]\n",
        "\n",
        "for layer in LAYERS:\n",
        "    layer_df = predictions_df[predictions_df[\"layer\"] == layer]\n",
        "    for condition in MATRIX_CONDITIONS:\n",
        "        steering, t10_action = condition_parts(condition)\n",
        "        baseline_condition = column_baseline_condition(t10_action)\n",
        "        target_df = layer_df[layer_df[\"condition\"] == condition].copy()\n",
        "        base_df = layer_df[layer_df[\"condition\"] == baseline_condition].copy()\n",
        "        merged = target_df.merge(\n",
        "            base_df,\n",
        "            on=\"pair_id\",\n",
        "            suffixes=(\"_target\", \"_base\"),\n",
        "            validate=\"one_to_one\",\n",
        "        )\n",
        "\n",
        "        target_digits = merged[\"analysis_target_mod10_target\"].to_numpy(dtype=int)\n",
        "        base_predictions = merged[\"pred_base\"].to_numpy()\n",
        "        base_parseable = np.asarray(\n",
        "            [prediction is not None and not pd.isna(prediction) for prediction in base_predictions],\n",
        "            dtype=bool,\n",
        "        )\n",
        "        base_predictions_int = np.where(base_parseable, base_predictions, -999).astype(int)\n",
        "        A_units = merged[\"units_A_target\"].to_numpy(dtype=int)\n",
        "        A_tens = merged[\"tens_A_target\"].to_numpy(dtype=int)\n",
        "\n",
        "        base_metric_values = {\n",
        "            \"follow_target_mod2\": (\n",
        "                base_parseable & (base_predictions_int % 2 == target_digits % 2)\n",
        "            ).astype(int),\n",
        "            \"follow_target_mod5\": (\n",
        "                base_parseable & (base_predictions_int % 5 == target_digits % 5)\n",
        "            ).astype(int),\n",
        "            \"follow_target_mod10\": (\n",
        "                base_parseable & (base_predictions_int % 10 == target_digits)\n",
        "            ).astype(int),\n",
        "            \"stay_A_mod10\": (\n",
        "                base_parseable & (base_predictions_int % 10 == A_units)\n",
        "            ).astype(int),\n",
        "            \"stay_A_tens\": (\n",
        "                base_parseable & ((base_predictions_int // 10) % 10 == A_tens)\n",
        "            ).astype(int),\n",
        "            \"exact_A\": merged[\"exact_A_base\"].to_numpy(dtype=int),\n",
        "        }\n",
        "\n",
        "        for metric in binary_metrics:\n",
        "            target_values = merged[f\"{metric}_target\"].to_numpy(dtype=int)\n",
        "            base_values = base_metric_values[metric]\n",
        "            differences = target_values - base_values\n",
        "            mean, low, high = mean_ci95(differences)\n",
        "            paired_rows.append({\n",
        "                \"layer\": layer,\n",
        "                \"condition\": condition,\n",
        "                \"baseline_condition\": baseline_condition,\n",
        "                \"metric\": metric,\n",
        "                \"n\": len(merged),\n",
        "                \"mean_change\": mean,\n",
        "                \"ci95_low\": low,\n",
        "                \"ci95_high\": high,\n",
        "                \"mcnemar_exact_p\": exact_mcnemar_p(target_values, base_values),\n",
        "            })\n",
        "\n",
        "        target_logprob = merged[\"target_units_logprob_target\"].to_numpy()\n",
        "        base_logprob = np.asarray([\n",
        "            merged.iloc[index][f\"units_logprob_{digit}_base\"]\n",
        "            for index, digit in enumerate(target_digits)\n",
        "        ])\n",
        "        A_target_logprob = merged[\"A_units_logprob_target\"].to_numpy()\n",
        "        A_base_logprob = merged[\"A_units_logprob_base\"].to_numpy()\n",
        "        logprob_did = (\n",
        "            (target_logprob - A_target_logprob)\n",
        "            - (base_logprob - A_base_logprob)\n",
        "        )\n",
        "        mean, low, high = mean_ci95(logprob_did)\n",
        "        paired_rows.append({\n",
        "            \"layer\": layer,\n",
        "            \"condition\": condition,\n",
        "            \"baseline_condition\": baseline_condition,\n",
        "            \"metric\": \"target_vs_A_units_logprob\",\n",
        "            \"n\": len(merged),\n",
        "            \"mean_change\": mean,\n",
        "            \"ci95_low\": low,\n",
        "            \"ci95_high\": high,\n",
        "            \"mcnemar_exact_p\": float(\"nan\"),\n",
        "        })\n",
        "\n",
        "paired_df = pd.DataFrame(paired_rows)\n",
        "paired_path = os.path.join(OUT_DIR, \"test14_paired_column_contrasts.csv\")\n",
        "paired_df.to_csv(paired_path, index=False)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# T10-GATE DIFFERENCE-IN-DIFFERENCES\n",
        "# =============================================================================\n",
        "\n",
        "gate_rows = []\n",
        "for layer in LAYERS:\n",
        "    for steering in STEERING_MODES:\n",
        "        for metric in [\n",
        "            \"follow_target_mod2\",\n",
        "            \"follow_target_mod5\",\n",
        "            \"follow_target_mod10\",\n",
        "            \"target_vs_A_units_logprob\",\n",
        "        ]:\n",
        "            keep_row = paired_df[\n",
        "                (paired_df[\"layer\"] == layer)\n",
        "                & (paired_df[\"condition\"] == f\"{steering}__t10_keep\")\n",
        "                & (paired_df[\"metric\"] == metric)\n",
        "            ].iloc[0]\n",
        "            ablate_row = paired_df[\n",
        "                (paired_df[\"layer\"] == layer)\n",
        "                & (paired_df[\"condition\"] == f\"{steering}__t10_ablate\")\n",
        "                & (paired_df[\"metric\"] == metric)\n",
        "            ].iloc[0]\n",
        "            write_row = paired_df[\n",
        "                (paired_df[\"layer\"] == layer)\n",
        "                & (paired_df[\"condition\"] == f\"{steering}__t10_write\")\n",
        "                & (paired_df[\"metric\"] == metric)\n",
        "            ].iloc[0]\n",
        "            gate_rows.append({\n",
        "                \"layer\": layer,\n",
        "                \"steering\": steering,\n",
        "                \"metric\": metric,\n",
        "                \"steering_effect_t10_keep\": keep_row[\"mean_change\"],\n",
        "                \"steering_effect_t10_ablate\": ablate_row[\"mean_change\"],\n",
        "                \"steering_effect_t10_write\": write_row[\"mean_change\"],\n",
        "                \"ablate_minus_keep_DID\": (\n",
        "                    ablate_row[\"mean_change\"] - keep_row[\"mean_change\"]\n",
        "                ),\n",
        "                \"write_minus_keep_DID\": (\n",
        "                    write_row[\"mean_change\"] - keep_row[\"mean_change\"]\n",
        "                ),\n",
        "                \"write_minus_ablate_DID\": (\n",
        "                    write_row[\"mean_change\"] - ablate_row[\"mean_change\"]\n",
        "                ),\n",
        "            })\n",
        "\n",
        "gate_df = pd.DataFrame(gate_rows)\n",
        "gate_path = os.path.join(OUT_DIR, \"test14_t10_gate_difference_in_differences.csv\")\n",
        "gate_df.to_csv(gate_path, index=False)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# T2/T5 FACTORIAL INTERACTION ON THE COMMON B-DIGIT LOG PROBABILITY\n",
        "# =============================================================================\n",
        "\n",
        "interaction_rows = []\n",
        "for layer in LAYERS:\n",
        "    layer_df = predictions_df[predictions_df[\"layer\"] == layer]\n",
        "    for t10_action in T10_ACTIONS:\n",
        "        baseline_condition = column_baseline_condition(t10_action)\n",
        "        condition_names = {\n",
        "            \"none\": baseline_condition,\n",
        "            \"t2\": f\"t2_only__t10_{t10_action}\",\n",
        "            \"t5\": f\"t5_only__t10_{t10_action}\",\n",
        "            \"both\": f\"t2t5__t10_{t10_action}\",\n",
        "        }\n",
        "        frames = {}\n",
        "        for key, condition in condition_names.items():\n",
        "            frame = layer_df[layer_df[\"condition\"] == condition].copy()\n",
        "            frame = frame.sort_values(\"pair_id\").reset_index(drop=True)\n",
        "            frames[key] = frame\n",
        "\n",
        "        pair_ids = frames[\"none\"][\"pair_id\"].to_numpy()\n",
        "        if not all(np.array_equal(frame[\"pair_id\"].to_numpy(), pair_ids) for frame in frames.values()):\n",
        "            raise RuntimeError(\"Factorial rows are not paired in the same order.\")\n",
        "\n",
        "        B_digits = frames[\"none\"][\"target_t2t5\"].to_numpy(dtype=int)\n",
        "        B_logprobs = {}\n",
        "        for key, frame in frames.items():\n",
        "            B_logprobs[key] = np.asarray([\n",
        "                frame.iloc[index][f\"units_logprob_{digit}\"]\n",
        "                for index, digit in enumerate(B_digits)\n",
        "            ])\n",
        "        interaction = (\n",
        "            B_logprobs[\"both\"]\n",
        "            - B_logprobs[\"t2\"]\n",
        "            - B_logprobs[\"t5\"]\n",
        "            + B_logprobs[\"none\"]\n",
        "        )\n",
        "        mean, low, high = mean_ci95(interaction)\n",
        "        interaction_rows.append({\n",
        "            \"layer\": layer,\n",
        "            \"t10_action\": t10_action,\n",
        "            \"metric\": \"B_units_logprob_factorial_interaction\",\n",
        "            \"n\": len(interaction),\n",
        "            \"mean_interaction\": mean,\n",
        "            \"ci95_low\": low,\n",
        "            \"ci95_high\": high,\n",
        "        })\n",
        "\n",
        "interaction_df = pd.DataFrame(interaction_rows)\n",
        "interaction_path = os.path.join(OUT_DIR, \"test14_t2_t5_factorial_interaction.csv\")\n",
        "interaction_df.to_csv(interaction_path, index=False)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# COMPACT AUDIT SUMMARY AND CONFIG\n",
        "# =============================================================================\n",
        "\n",
        "audit_summary_df = (\n",
        "    audit_df\n",
        "    .groupby([\"layer\", \"condition\"], as_index=False)\n",
        "    .agg(\n",
        "        mean_post_over_pre_q10_norm=(\n",
        "            \"mean_post_over_pre_q10_norm\",\n",
        "            \"mean\",\n",
        "        ),\n",
        "        mean_relative_q25_coordinate_change=(\n",
        "            \"mean_relative_q25_coordinate_change\",\n",
        "            \"mean\",\n",
        "        ),\n",
        "        mean_edit_norm=(\"mean_edit_norm\", \"mean\"),\n",
        "    )\n",
        ")\n",
        "audit_summary_path = os.path.join(OUT_DIR, \"test14_intervention_audit_summary.csv\")\n",
        "audit_summary_df.to_csv(audit_summary_path, index=False)\n",
        "\n",
        "config = {\n",
        "    \"model_name\": MODEL_NAME,\n",
        "    \"seed\": SEED,\n",
        "    \"ridge_alpha\": RIDGE_ALPHA,\n",
        "    \"fit_n\": len(fit_rows),\n",
        "    \"eval_n\": len(pairs),\n",
        "    \"fit_eval_disjoint\": True,\n",
        "    \"layers\": LAYERS,\n",
        "    \"conditions\": CONDITIONS,\n",
        "    \"t10_control_basis\": T10_CONTROL_BASIS,\n",
        "    \"smoke_test\": SMOKE_TEST,\n",
        "    \"single_shot_only\": True,\n",
        "    \"edit_dtype\": \"float32_then_cast_back\",\n",
        "}\n",
        "config_path = os.path.join(OUT_DIR, \"test14_config.json\")\n",
        "with open(config_path, \"w\") as file:\n",
        "    json.dump(config, file, indent=2)\n",
        "\n",
        "\n",
        "# =============================================================================\n",
        "# COMPACT FINAL PRINT\n",
        "# =============================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 110)\n",
        "print(\"FINAL SUMMARY\")\n",
        "print(\"=\" * 110)\n",
        "print(summary_df.to_string(index=False))\n",
        "\n",
        "print(\"\\nKEY T10-GATE DIFFERENCE-IN-DIFFERENCES\")\n",
        "print(gate_df.to_string(index=False))\n",
        "\n",
        "print(\"\\nT2/T5 FACTORIAL INTERACTION\")\n",
        "print(interaction_df.to_string(index=False))\n",
        "\n",
        "print(\"\\nQ10 HELD-OUT CALIBRATION\")\n",
        "print(q10_calibration_df.to_string(index=False))\n",
        "\n",
        "print(\"\\nBASIS OVERLAP AUDIT\")\n",
        "print(basis_audit_df.to_string(index=False))\n",
        "\n",
        "print(\"\\nINTERVENTION AUDIT — ABLATE/WRITE/RANDOM CONTROLS\")\n",
        "important_audit = audit_summary_df[\n",
        "    audit_summary_df[\"condition\"].isin([\n",
        "        \"t10_ablate_only\",\n",
        "        \"t10_write_only\",\n",
        "        \"random_ablate\",\n",
        "        \"t2_only__t10_ablate\",\n",
        "        \"t5_only__t10_ablate\",\n",
        "        \"t2t5__t10_ablate\",\n",
        "        \"t2t5__t10_write\",\n",
        "    ])\n",
        "]\n",
        "print(important_audit.to_string(index=False))\n",
        "\n",
        "print(\"\\nSaved under:\", OUT_DIR)\n",
        "print(\"summary:\", summary_path)\n",
        "print(\"paired contrasts:\", paired_path)\n",
        "print(\"T10 gate DID:\", gate_path)\n",
        "print(\"T2/T5 interaction:\", interaction_path)\n",
        "print(\"predictions:\", predictions_path)\n",
        "print(\"Q10 calibration:\", q10_calibration_path)\n",
        "print(\"basis audit:\", basis_audit_path)\n",
        "print(\"intervention audit:\", audit_summary_path)"
      ]
    }
  ]
}